@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var esLogin = currentPage == "/Login";

    var inicioAbierto =
        currentPage.StartsWith("/Clientes")
        || currentPage.StartsWith("/NuevoCliente")
        || currentPage.StartsWith("/EditarCliente")
        || currentPage.StartsWith("/Vehiculos")
        || currentPage.StartsWith("/NuevoVehiculo")
        || currentPage.StartsWith("/EditarVehiculo")
        || currentPage.StartsWith("/Servicios")
        || currentPage.StartsWith("/NuevoServicio")
        || currentPage.StartsWith("/EditarServicio");
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - AlánezMotors
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <div class="d-flex min-vh-100">

        @if (!esLogin)
        {
            <!-- SIDEBAR -->
            <aside class="sidebar d-flex flex-column text-white">

                <div class="sidebar-logo-container">

                    <!-- LOGO CLICABLE: IR A INICIO -->
                    <a asp-page="/Index"
                       class="d-flex justify-content-center align-items-center text-decoration-none"
                       aria-label="Ir a Inicio">

                        <img src="~/images/alanezmotors.png"
                             alt="AlánezMotors"
                             class="logo-sidebar" />

                    </a>

                </div>

                <nav class="nav flex-column sidebar-nav">

                    <!-- PANEL PRINCIPAL -->
                    <a asp-page="/Index"
                       class="nav-link sidebar-link @(currentPage == "/Index" ? "active" : "")">

                        <span class="sidebar-link-content">
                            <i class="bi bi-speedometer2"></i>
                            <span>Panel Principal</span>
                        </span>

                    </a>

                    <!-- GESTIÓN (SUBMENÚ) -->
                    <button type="button"
                            id="btnToggleGestion"
                            class="nav-link sidebar-link sidebar-toggle w-100 text-start border-0 bg-transparent @(inicioAbierto ? "open" : "")"
                            aria-expanded="@(inicioAbierto ? "true" : "false")"
                            aria-controls="submenuInicio">

                        <span class="sidebar-link-content">
                            <i class="bi bi-house-door"></i>
                            <span>Gestión</span>
                        </span>

                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </button>

                    <!-- SUBMENU GESTIÓN -->
                    <div class="collapse @(inicioAbierto ? "show" : "")"
                         id="submenuInicio">

                        <div class="sidebar-submenu">

                            <!-- CLIENTES -->
                            <a href="/Clientes"
                               class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Clientes") || currentPage.StartsWith("/NuevoCliente") || currentPage.StartsWith("/EditarCliente") ? "active" : "")">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-people"></i>
                                    <span>Clientes</span>
                                </span>

                            </a>

                            <!-- VEHÍCULOS -->
                            <a href="/Vehiculos"
                               class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Vehiculos") || currentPage.StartsWith("/NuevoVehiculo") || currentPage.StartsWith("/EditarVehiculo") ? "active" : "")">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-car-front"></i>
                                    <span>Vehículos</span>
                                </span>

                            </a>

                            <!-- SERVICIOS -->
                            <a href="/Servicios"
                               class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Servicios") || currentPage.StartsWith("/NuevoServicio") || currentPage.StartsWith("/EditarServicio") ? "active" : "")">

                                <span class="sidebar-link-content">
                                    <i class="bi bi-wrench-adjustable"></i>
                                    <span>Servicios</span>
                                </span>

                            </a>

                        </div>
                    </div>

                    <!-- ÓRDENES DE TRABAJO -->
                    <a asp-page="/OrdenesTrabajo"
                       class="nav-link sidebar-link @(currentPage.StartsWith("/OrdenesTrabajo") ? "active" : "")">

                        <span class="sidebar-link-content">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Órdenes de Trabajo</span>
                        </span>

                    </a>

                    <!-- REPUESTOS -->
                    <a asp-page="/Repuestos/Index"
                       class="nav-link sidebar-link @(currentPage.StartsWith("/Repuestos") ? "active" : "")">

                        <span class="sidebar-link-content">
                            <i class="bi bi-box-seam"></i>
                            <span>Repuestos</span>
                        </span>

                    </a>

                    <!-- ENTREGAS -->
                    <a asp-page="/Entregas/Index"
                       class="nav-link sidebar-link @(currentPage.StartsWith("/Entregas") ? "active" : "")">

                        <span class="sidebar-link-content">
                            <i class="bi bi-truck"></i>
                            <span>Entregas</span>
                        </span>

                    </a>

                </nav>
            </aside>
        }

        <!-- CONTENIDO PRINCIPAL -->
        <div class="flex-grow-1 bg-light">

            @if (!esLogin)
            {
                <!-- CABECERA: SOLO FUERA DEL LOGIN -->
                <header class="bg-white border-bottom px-4 py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h5 class="mb-0 fw-semibold">
                            @ViewData["Title"]
                        </h5>

                        <div class="d-flex align-items-center gap-4 text-secondary">

                            <!-- FECHA -->
                            <div>
                                <i class="bi bi-calendar3 me-2"></i>
                                @DateTime.Now.ToString("dd/MM/yyyy")
                            </div>

                            <!-- USUARIO: CLIC PARA IR A INICIO -->
                            <a asp-page="/Index"
                               class="text-secondary text-decoration-none d-flex align-items-center">

                                <i class="bi bi-person-circle fs-5 me-2 text-primary"></i>
                                Administrador

                            </a>

                            <!-- CERRAR SESIÓN -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form method="post"
                                      asp-page="/Logout"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Cerrar sesión

                                    </button>

                                </form>
                            }

                        </div>
                    </div>
                </header>
            }

            <!-- CONTENIDO DE CADA PÁGINA -->
            <main class="p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnGestion = document.getElementById("btnToggleGestion");
            const submenu = document.getElementById("submenuInicio");

            if (btnGestion && submenu && window.bootstrap) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(submenu, {
                    toggle: false
                });

                btnGestion.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const estaAbierto = submenu.classList.contains("show");
                    if (estaAbierto) {
                        bsCollapse.hide();
                        btnGestion.classList.remove("open");
                        btnGestion.setAttribute("aria-expanded", "false");
                    } else {
                        bsCollapse.show();
                        btnGestion.classList.add("open");
                        btnGestion.setAttribute("aria-expanded", "true");
                    }
                });
            }

            document.querySelectorAll("#submenuInicio a.nav-link").forEach(function (enlace) {
                enlace.addEventListener("click", function (event) {
                    const url = enlace.getAttribute("href");
                    if (url) {
                        event.stopPropagation();
                        window.location.assign(url);
                    }
                });
            });
        });
    </script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>