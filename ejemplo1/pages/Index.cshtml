@page
@model ejemplo1.pages.IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<script>
    (function () {
        if (!document.querySelector('link[href*="bootstrap.min.css"]')) {
            const bsCss = document.createElement('link');
            bsCss.rel = 'stylesheet';
            bsCss.href = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css';
            document.head.appendChild(bsCss);
        }

        if (!document.querySelector('link[href*="bootstrap-icons.min.css"]')) {
            const biCss = document.createElement('link');
            biCss.rel = 'stylesheet';
            biCss.href = 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css';
            document.head.appendChild(biCss);
        }

        if (!document.getElementById('dashboard-custom-style')) {
            const style = document.createElement('style');
            style.id = 'dashboard-custom-style';
            style.textContent = `
                    .dashboard-icon {
                        width: 48px;
                        height: 48px;
                        border-radius: 12px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.4rem;
                        flex-shrink: 0;
                    }
                `;
            document.head.appendChild(style);
        }

        if (!window.bootstrap && !document.querySelector('script[src*="bootstrap.bundle.min.js"]')) {
            const bsJs = document.createElement('script');
            bsJs.src = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js';
            bsJs.defer = true;
            document.body.appendChild(bsJs);
        }
    })();
</script>

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Panel Principal</h2>
        <p class="text-muted">Resumen del estado actual de los vehículos del taller</p>
    </div>

    <!-- ========================= -->
    <!-- TARJETAS DE RESUMEN -->
    <!-- ========================= -->
    <div class="row g-3 mb-4">

        <!-- VEHÍCULOS -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="dashboard-icon bg-primary-subtle text-primary">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted">Vehículos registrados</small>
                        <h2 class="fw-bold mb-0">@Model.TotalVehiculos</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- EN REPARACIÓN -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="dashboard-icon bg-warning-subtle text-warning">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <small class="text-muted">En reparación</small>
                        <h2 class="fw-bold mb-0">@Model.TotalEnReparacion</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- LISTOS -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="dashboard-icon bg-success-subtle text-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted">Listos para entregar</small>
                        <h2 class="fw-bold mb-0">@Model.TotalListosEntrega</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- ENTREGAS -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="dashboard-icon bg-danger-subtle text-danger">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted">Entregas de hoy</small>
                        <h2 class="fw-bold mb-0">@Model.TotalEntregasHoy</h2>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================= -->
    <!-- TABLA DE VEHÍCULOS -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">Vehículos registrados</h5>
                    <small class="text-muted">Información actual de los vehículos</small>
                </div>
                <span class="badge bg-primary">
                    @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (Model.Vehiculos.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No hay vehículos registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Placa</th>
                                <th>Cliente</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Año</th>
                                <th>Tipo</th>
                                <th>Kilometraje</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Vehiculos.Count; i++)
                            {
                                var v = Model.Vehiculos[i];
                                <tr>
                                    <td class="fw-semibold">@v.Placa</td>
                                    <td>@v.ClienteNombre</td>
                                    <td>@v.Marca</td>
                                    <td>@v.Modelo</td>
                                    <td>@v.Anio</td>
                                    <td>@v.Tipo</td>
                                    <td>@v.Kilometraje km</td>
                                    <td>
                                        <span class="badge bg-success">Activo</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>

    </div>

</div>